algoritmo "BEM_VINDO"

var

vNome: caractere
vIdade: inteiro
vSobrenome: caractere
inicio

escreva("Digite sua idade: ")
leia(vIdade)
escreva("Digite seu nome: ")
leia(vNome)
escreva("Digite seu sobrenome: ")
leia(vSobrenome)
escreval("Bem vindo ", vNome," ",vSobrenome, ", sua idade é", vIdade, " anos")

fimalgoritmo