algoritmo "calculo_da_area"

var

comprimento: real
largura: real
area: real

inicio

escreva("Digite o comprimento do terreno: ")
leia(comprimento)

escreva("Digite a largura do terreno: ")
leia(largura)

area <- comprimento * largura

escreval("O tamanho da área é: ", area, "m³")

fimalgoritmo