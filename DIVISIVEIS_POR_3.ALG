Algoritmo "Divisiveis_por_3"

Var
 numero, contador, soma: inteiro

Inicio

contador <- 1
escreva("Digite um número: ")
leia(numero)

   Enquanto contador <= numero faca
        se (contador % 3) = 0 entao
           escreva(contador, " ")
        fimse
            
      contador <- contador + 1
   FimEnquanto




Fimalgoritmo