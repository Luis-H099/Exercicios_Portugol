Algoritmo "Contagem_regressiva_N"

Var
 numero, contador, soma: inteiro

Inicio

contador <- 0
escreva("Digite um número: ")
leia(numero)

   Enquanto numero > 0 faca
            escreva(numero , ",")
            
      numero <- numero - 1
   FimEnquanto
   escreva(0)



Fimalgoritmo